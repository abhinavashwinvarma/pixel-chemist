; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pixel Chemist"
run/main_scene="res://Scenes/UI/title_screen.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://Assets/Sprites/logo.png"

[autoload]

Manager="*res://Scripts/manager.gd"

[display]

window/size/mode=2
window/stretch/mode="viewport"

[gui]

theme/custom_font="res://Assets/Fonts/dogica/TTF/dogicabold.ttf"

[rendering]

textures/canvas_textures/default_texture_filter=0
